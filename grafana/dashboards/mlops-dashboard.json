{
  "title": "Health Lifestyle MLOps Demo",
  "uid": "health-mlops-demo",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Prediction requests",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "health_demo_predictions_total",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Prediction request rate",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "expr": "rate(health_demo_predictions_total[5m])",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "API errors",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "expr": "health_demo_api_errors_total",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Prediction latency p95",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95,sum(rate(health_demo_prediction_latency_seconds_bucket[5m])) by (le))",
          "refId": "A"
        }
      ]
    }
  ]
}